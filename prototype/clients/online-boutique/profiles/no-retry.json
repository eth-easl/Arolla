{
  "name": "no-retry",
  "description": "Control profile — no client-side retries at all. Useful as a baseline for \"what the server naturally serves\" under fault injection, and for measuring the failure rate visible to end-users with no retry amplification.",

  "count": 2,
  "rate_rps_per_client": 1.0,
  "timeout_s": 2.0,

  "sku_pool": [
    "OLJCESPC7Z", "66VCHSJNUP", "1YMWWN1N4O", "L9ECAV7KIM", "2ZYFJ3GM2N",
    "0PUK6V6EV0", "LS4PSXUNUM", "9SIQT8TOJO", "6E92ZMYYFZ"
  ],

  "requests": [
    { "name": "home",           "weight": 20, "method": "GET", "path": "/" },
    { "name": "browse-product", "weight": 25, "method": "GET", "path": "/product/{sku}" },
    { "name": "view-cart",      "weight": 20, "method": "GET", "path": "/cart" },
    { "name": "add-to-cart",    "weight": 20,
      "method": "POST", "path": "/cart",
      "body": "product_id={sku}&quantity=1",
      "content_type": "application/x-www-form-urlencoded" },
    { "name": "checkout-flow",  "weight": 15,
      "workflow": [
        { "name": "checkout-add",
          "method": "POST", "path": "/cart",
          "body": "product_id={sku}&quantity=1",
          "content_type": "application/x-www-form-urlencoded" },
        { "name": "checkout-place",
          "method": "POST", "path": "/cart/checkout",
          "body": "email=someone%40example.com&street_address=1+Main+St&zip_code=94000&city=San+Francisco&state=CA&country=United+States&credit_card_number=4432-8015-6152-0454&credit_card_expiration_month=1&credit_card_expiration_year=2040&credit_card_cvv=672",
          "content_type": "application/x-www-form-urlencoded" }
      ]
    }
  ],

  "retries": 0,
  "backoff": { "mode": "none" },
  "retry_on_status": []
}
